static void skyColors(float n, float* hor, float* zen) {
    const float dz[3] = {0.20f, 0.46f, 0.88f}, dh[3] = {0.72f, 0.86f, 0.98f};
    const float nz[3] = {0.004f, 0.008f, 0.045f}, nh[3] = {0.05f, 0.07f, 0.18f};
    float dusk = sinf(PI * n);
    for (int i = 0; i < 3; i++) { zen[i] = mixf(dz[i], nz[i], n); hor[i] = mixf(dh[i], nh[i], n); }
    hor[0] += 0.45f * dusk; hor[1] += 0.17f * dusk; hor[2] -= 0.04f * dusk; zen[0] += 0.12f * dusk;
    for (int i = 0; i < 3; i++) { hor[i] = clamp01(hor[i]); zen[i] = clamp01(zen[i]); }
}

