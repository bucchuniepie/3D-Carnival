static const float MOON_D[3] = {-0.38f, 0.52f, -0.76f};

static void drawBody(const float* d, float rad, float r, float g, float b, float alpha, bool moon) {
    float L = sqrtf(d[0] * d[0] + d[1] * d[1] + d[2] * d[2]);
    float dx = d[0] / L, dy = d[1] / L, dz = d[2] / L;
    glPushMatrix(); glTranslatef(dx * 450, dy * 450, dz * 450);
    glBlendFunc(GL_SRC_ALPHA, GL_ONE);
    for (int i = 0; i < 12; i++) {                           // soft halo: many faint layers
        float t = i / 11.0f;
        glColor4f(r, g, b, 0.022f * alpha * (0.4f + t));
        glutSolidSphere(rad * (3.6f - 2.5f * t), 24, 16);
    }
    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
    glColor4f(r, g, b, alpha); glutSolidSphere(rad, 28, 20);
    if (moon) {                                               // craters facing the viewer
        glRotatef(atan2f(dx, dz) / DEG, 0, 1, 0); glRotatef(-asinf(dy) / DEG, 1, 0, 0);
        static const float cr[6][3] = {{-0.3f, 0.25f, 0.2f}, {0.35f, 0.1f, 0.15f}, {0.05f, -0.35f, 0.25f},
                                       {-0.45f, -0.2f, 0.12f}, {0.4f, -0.4f, 0.1f}, {0.1f, 0.5f, 0.12f}};
        glColor4f(0.72f, 0.74f, 0.80f, alpha);
        for (int i = 0; i < 6; i++) {
            float cx = cr[i][0] * rad, cy = cr[i][1] * rad, cs = cr[i][2] * rad;
            float cz = -sqrtf(std::max(0.0f, rad * rad - cx * cx - cy * cy)) * 0.985f;
            glPushMatrix(); glTranslatef(cx, cy, cz); glScalef(1, 1, 0.25f); glutSolidSphere(cs, 12, 8); glPopMatrix();
        }
    }
    glPopMatrix();
}

static void drawSky(const float* hor, const float* zen) {
    glDisable(GL_LIGHTING); glDisable(GL_FOG); glDisable(GL_DEPTH_TEST); glDepthMask(GL_FALSE);
    glPushMatrix(); glTranslatef(camX, eyeH, camZ);
    const int SL = 14, SG = 36; const float R = 600;
    for (int i = 0; i < SL; i++) {
        float lat0 = -10 + i * 100.0f / SL, lat1 = -10 + (i + 1) * 100.0f / SL;
        glBegin(GL_QUAD_STRIP);
        for (int j = 0; j <= SG; j++) {
            float lon = j * 2 * PI / SG;
            for (int k = 0; k < 2; k++) {
                float lat = (k == 0 ? lat1 : lat0) * DEG;
                float t = powf(std::max(0.0f, sinf(lat)), 0.45f);
                glColor3f(mixf(hor[0], zen[0], t), mixf(hor[1], zen[1], t), mixf(hor[2], zen[2], t));
                glVertex3f(R * cosf(lat) * sinf(lon), R * sinf(lat), -R * cosf(lat) * cosf(lon));
            }
        }
        glEnd();
    }
    glEnable(GL_BLEND); glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
    if (night > 0.03f) {                                          // stars
        for (int pass = 0; pass < 2; pass++) {
            glPointSize(pass ? 3.0f : 1.6f);
            glBegin(GL_POINTS);
            for (int i = 0; i < 900; i++) {
                if ((i % 9 == 0) != (pass == 1)) continue;
                float tw = 0.65f + 0.35f * sinf(animT * (1.0f + (i % 5) * 0.4f) + starPh[i]);
                float a = night * tw * clamp01(starP[i][1] / 120.0f + 0.1f);
                glColor4f(0.85f + 0.15f * (i % 3 == 0), 0.9f, 1.0f - 0.2f * (i % 4 == 0), a);
                glVertex3f(starP[i][0], starP[i][1], starP[i][2]);
            }
            glEnd();
        }
    }
    if (night > 0.03f) drawBody(MOON_D, 26, 0.96f, 0.96f, 0.88f, smooth(night), true);
    if (night < 0.97f) drawBody(SUN_D, 30, 1.0f, 0.93f, 0.55f, smooth(1 - night), false);
    glPopMatrix();
    glEnable(GL_DEPTH_TEST);
    if (night < 0.95f) {                                          // clouds (day)
        static const float off[6][4] = {{0, 0, 0, 1.0f}, {1.2f, 0.2f, 0.3f, 0.8f}, {-1.3f, 0.1f, -0.2f, 0.85f},
                                        {0.4f, 0.4f, -0.5f, 0.7f}, {2.2f, -0.1f, 0.1f, 0.6f}, {-2.3f, -0.1f, 0.2f, 0.6f}};
        float a = 0.92f * (1 - night);
        for (int c = 0; c < 12; c++) {
            float cx = fmodf(clouds[c].x + animT * 1.6f + 500.0f, 1000.0f) - 500.0f;
            for (int p = 0; p < 6; p++) {
                glColor4f(mixf(1.0f, hor[0] * 1.2f, 0.3f), mixf(1.0f, hor[1] * 1.2f, 0.3f), mixf(1.0f, hor[2] * 1.2f, 0.3f), a);
                glPushMatrix();
                glTranslatef(cx + off[p][0] * clouds[c].s, clouds[c].y + off[p][1] * clouds[c].s, clouds[c].z + off[p][2] * clouds[c].s);
                glScalef(1.0f, 0.42f, 0.7f); glutSolidSphere(clouds[c].s * off[p][3], 12, 8);
                glPopMatrix();
            }
        }
    }
    glDisable(GL_BLEND); glDepthMask(GL_TRUE);
}

// ------------------------------------------------------------ HUD
static void text2D(float x, float y, const char* s, void* font = GLUT_BITMAP_9_BY_15) {
    glRasterPos2f(x, y);
    for (; *s; s++) glutBitmapCharacter(font, *s);
}
static void drawHUD() {
    glDisable(GL_LIGHTING); glDisable(GL_FOG); glDisable(GL_DEPTH_TEST);
    glMatrixMode(GL_PROJECTION); glPushMatrix(); glLoadIdentity(); gluOrtho2D(0, winW, 0, winH);
    glMatrixMode(GL_MODELVIEW); glPushMatrix(); glLoadIdentity();
    char buf[160];
    float k = night > 0.5f ? 1.0f : 0.1f;
    glColor3f(k, k, k * 0.9f + 0.1f);
    snprintf(buf, sizeof buf, "%s  |  Carnival: %s  |  %s", night > 0.5f ? "NIGHT" : "DAY",
             carnivalOpen ? (power < 0.98f ? "opening..." : "OPEN") : (power > 0.02f ? "shutting down..." : "CLOSED"),
             paused ? "PAUSED" : "running");
    text2D(12, winH - 22.0f, buf);
    if (showHelp) {
        const char* L[] = {"W A S D  walk (SHIFT run)   Arrows  look   Mouse wheel  glide   M  mouse-look",
                           "N  day/night   P / SPACE  pause   C  close/reopen carnival   Q/E  fly   R  reset   H  hide help"};
        for (int i = 0; i < 2; i++) text2D(12, 28.0f - i * 18.0f, L[i], GLUT_BITMAP_8_BY_13);
    }
    if (paused) { glColor3f(1, 0.85f, 0.3f); text2D(winW / 2 - 45.0f, winH / 2 + 80.0f, "|| PAUSED", GLUT_BITMAP_HELVETICA_18); }
    if (!carnivalOpen && power < 0.3f) { glColor3f(1, 0.35f, 0.3f); text2D(winW / 2 - 105.0f, winH / 2 + 110.0f, "THE CARNIVAL IS CLOSED  -  press C to reopen", GLUT_BITMAP_HELVETICA_18); }
    glPopMatrix(); glMatrixMode(GL_PROJECTION); glPopMatrix(); glMatrixMode(GL_MODELVIEW);
    glEnable(GL_DEPTH_TEST);
}

// ------------------------------------------------------------ update
static void tryMove(float nx, float nz) {
    nx = std::max(-75.0f, std::min(75.0f, nx)); nz = std::max(-100.0f, std::min(80.0f, nz));
    bool ghost = eyeH > 7.0f;                                  // flying: ignore obstacles
    if (ghost || !solid(nx, camZ, camX, camZ)) camX = nx;
    if (ghost || !solid(camX, nz, camX, camZ)) camZ = nz;
}

static void update(float dt) {
    // smooth transitions (run even while paused so N and C stay responsive)
    float nt = nightTarget ? 1.0f : 0.0f;
    night += (nt - night) * std::min(1.0f, dt * 1.2f);
    if (fabsf(nt - night) < 0.003f) night = nt;
    float pt = carnivalOpen ? 1.0f : 0.0f, step = dt * 0.35f;
    power += std::max(-step, std::min(step, pt - power));
    lamp = power * (0.3f + 0.7f * night);
    glowLevel = power * smooth(night * 1.1f);

    int inside = 0;
    for (size_t i = 0; i < people.size(); i++) if (people[i].active && people[i].z < 25 && people[i].z > -82) inside++;
    bool wantOpen = carnivalOpen;
    if (!carnivalOpen) { closeTimer += dt; wantOpen = (inside > 0 && closeTimer < 40.0f); }
    float gt = wantOpen ? 100.0f : 0.0f, gs = 50 * dt;
    gateAng += std::max(-gs, std::min(gs, gt - gateAng));

    if (!paused) {
        animT += dt;
        ferrisAng += 8.0f * power * dt;
        carAng += 22.0f * power * dt;
        balloonT += dt * (0.5f + 0.5f * power);
        for (size_t i = 0; i < people.size(); i++) {
            Person& p = people[i];
            if (!p.active) {
                if (carnivalOpen && gateAng > 80) { p.spawn -= dt; if (p.spawn <= 0) { p.active = true; p.z = 32; p.dir = -1; } }
                continue;
            }
            if (!carnivalOpen) p.dir = 1;
            else { if (p.z < -58) p.dir = 1; if (p.z > 24 && p.z < 30) p.dir = -1; }
            float sp = p.speed * (carnivalOpen ? 1.0f : 2.2f);
            p.z += p.dir * sp * dt; p.dist += sp * dt;
            p.x = p.lane + 0.45f * sinf(p.dist * 0.35f + p.phase);
            if (!carnivalOpen && p.z > 34) p.active = false;
        }
    }

    // camera
    float sp = shiftHeld ? 11.0f : 5.5f;
    float fx = sinf(yaw * DEG), fz = -cosf(yaw * DEG), rx = cosf(yaw * DEG), rz = sinf(yaw * DEG);
    float mx = 0, mz = 0;
    if (keys['w']) { mx += fx; mz += fz; }
    if (keys['s']) { mx -= fx; mz -= fz; }
    if (keys['d']) { mx += rx; mz += rz; }
    if (keys['a']) { mx -= rx; mz -= rz; }
    float ml = sqrtf(mx * mx + mz * mz); if (ml > 1) { mx /= ml; mz /= ml; }
    float dx = (mx * sp + fx * scrollV) * dt, dz = (mz * sp + fz * scrollV) * dt;
    scrollV *= expf(-3.0f * dt);
    if (fabsf(dx) + fabsf(dz) > 1e-6f) tryMove(camX + dx, camZ + dz);
    if (sKeys[0]) yaw -= 90 * dt;
    if (sKeys[1]) yaw += 90 * dt;
    if (sKeys[2]) pitch += 60 * dt;
    if (sKeys[3]) pitch -= 60 * dt;
    pitch = std::max(-85.0f, std::min(85.0f, pitch));
    if (keys['e']) eyeH += 8 * dt;
    if (keys['q']) eyeH -= 8 * dt;
    eyeH = std::max(1.7f, std::min(60.0f, eyeH));
}

// ------------------------------------------------------------ render
static void display() {
    int ms = glutGet(GLUT_ELAPSED_TIME);
    float dt = (ms - lastMs) / 1000.0f; lastMs = ms; if (dt > 0.05f) dt = 0.05f; if (dt < 0) dt = 0;
    update(dt);

    float hor[3], zen[3]; skyColors(night, hor, zen);
    glClearColor(hor[0], hor[1], hor[2], 1);
    glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
    glMatrixMode(GL_MODELVIEW); glLoadIdentity();
    float py = pitch * DEG, yw = yaw * DEG;
    gluLookAt(camX, eyeH, camZ, camX + cosf(py) * sinf(yw), eyeH + sinf(py), camZ - cosf(py) * cosf(yw), 0, 1, 0);

    drawSky(hor, zen);

    // lighting: sun by day, moon by night
    float L[3]; for (int i = 0; i < 3; i++) L[i] = mixf(SUN_D[i], MOON_D[i], night);
    float ln = sqrtf(L[0] * L[0] + L[1] * L[1] + L[2] * L[2]);
    float lpos[4] = {L[0] / ln, L[1] / ln, L[2] / ln, 0};
    float dif[4] = {mixf(1.0f, 0.42f, night), mixf(0.95f, 0.50f, night), mixf(0.85f, 0.78f, night), 1};
    float amb[4] = {mixf(0.46f, 0.20f, night), mixf(0.48f, 0.23f, night), mixf(0.55f, 0.37f, night), 1};
    glEnable(GL_LIGHTING); glEnable(GL_LIGHT0);
    glLightfv(GL_LIGHT0, GL_POSITION, lpos); glLightfv(GL_LIGHT0, GL_DIFFUSE, dif); glLightfv(GL_LIGHT0, GL_AMBIENT, amb);
    float gam[4] = {amb[0] * 0.5f, amb[1] * 0.5f, amb[2] * 0.5f, 1};
    glLightModelfv(GL_LIGHT_MODEL_AMBIENT, gam);

    // fog = horizon colour
    glEnable(GL_FOG); glFogi(GL_FOG_MODE, GL_LINEAR);
    glFogf(GL_FOG_START, mixf(90.0f, 45.0f, night)); glFogf(GL_FOG_END, mixf(330.0f, 230.0f, night));
    float fc[4] = {hor[0], hor[1], hor[2], 1}; glFogfv(GL_FOG_COLOR, fc);

    glows.clear();
    glCallList(staticList);
    drawGate();
    for (int i = 0; i < 12; i++) drawShop(i);
    drawLamps();
    drawCarousel();
    drawFerris();
    drawTent();
    for (size_t i = 0; i < people.size(); i++) {
        const Person& p = people[i];
        if (!p.active) continue;
        drawPerson(p.x, p.z, p.dir < 0 ? 180.0f : 0.0f, sinf(p.dist * 3.2f), p.sh, p.pa, p.ha, p.sk, 1.0f);
    }
    drawBalloons();
    drawGlows();
    drawHUD();
    glutSwapBuffers();
}

// ------------------------------------------------------------ input
static void resetCam() { camX = 0; camZ = 52; eyeH = 1.7f; yaw = 0; pitch = -3; scrollV = 0; }

static void keyDown(unsigned char k, int, int) {
    shiftHeld = (glutGetModifiers() & GLUT_ACTIVE_SHIFT) != 0;
    int c = tolower(k);
    keys[c] = true;
    switch (c) {
    case 27: exit(0);
    case 'p': case ' ': paused = !paused; break;
    case 'n': nightTarget = !nightTarget; break;
    case 'h': showHelp = !showHelp; break;
    case 'r': resetCam(); break;
    case 'c':
        carnivalOpen = !carnivalOpen;
        if (carnivalOpen) { for (size_t i = 0; i < people.size(); i++) if (!people[i].active) people[i].spawn = frand(1.0f, 14.0f); }
        else closeTimer = 0;
        break;
    case 'm':
        mouseLook = !mouseLook;
        glutSetCursor(mouseLook ? GLUT_CURSOR_NONE : GLUT_CURSOR_INHERIT);
        if (mouseLook) { warping = true; glutWarpPointer(winW / 2, winH / 2); }
        break;
    case 'f':
        fullScr = !fullScr;
        if (fullScr) glutFullScreen(); else { glutReshapeWindow(1280, 720); glutPositionWindow(60, 40); }
        break;
    }
}
static void keyUp(unsigned char k, int, int) {
    shiftHeld = (glutGetModifiers() & GLUT_ACTIVE_SHIFT) != 0;
    keys[tolower(k)] = false;
}
static void specialDown(int k, int, int) {
    if (k == GLUT_KEY_LEFT)  sKeys[0] = true;
    if (k == GLUT_KEY_RIGHT) sKeys[1] = true;
    if (k == GLUT_KEY_UP)    sKeys[2] = true;
    if (k == GLUT_KEY_DOWN)  sKeys[3] = true;
}
static void specialUp(int k, int, int) {
    if (k == GLUT_KEY_LEFT)  sKeys[0] = false;
    if (k == GLUT_KEY_RIGHT) sKeys[1] = false;
    if (k == GLUT_KEY_UP)    sKeys[2] = false;
    if (k == GLUT_KEY_DOWN)  sKeys[3] = false;
}
static void mouseBtn(int button, int state, int, int) {
    if (state != GLUT_DOWN) return;
    if (button == 3) scrollV = std::min(scrollV + 7.0f, 24.0f);     // wheel up   -> glide forward
    if (button == 4) scrollV = std::max(scrollV - 7.0f, -24.0f);    // wheel down -> glide back
}
static void mouseMove(int x, int y) {
    if (!mouseLook) return;
    if (warping) { warping = false; return; }
    int cx = winW / 2, cy = winH / 2;
    if (x == cx && y == cy) return;
    yaw += (x - cx) * 0.12f; pitch -= (y - cy) * 0.12f;
    pitch = std::max(-85.0f, std::min(85.0f, pitch));
    warping = true; glutWarpPointer(cx, cy);
}
static void reshape(int w, int h) {
    winW = w; winH = h > 0 ? h : 1;
    glViewport(0, 0, winW, winH);
    glMatrixMode(GL_PROJECTION); glLoadIdentity();
    gluPerspective(65.0, (double)winW / winH, 0.2, 1500.0);
    glMatrixMode(GL_MODELVIEW);
}
static void timer(int) { glutPostRedisplay(); glutTimerFunc(16, timer, 0); }

// ------------------------------------------------------------ init
static void initScene() {
    Q = gluNewQuadric(); gluQuadricNormals(Q, GLU_SMOOTH);
    glEnable(GL_DEPTH_TEST); glEnable(GL_NORMALIZE); glShadeModel(GL_SMOOTH);
    glEnable(GL_COLOR_MATERIAL); glColorMaterial(GL_FRONT_AND_BACK, GL_AMBIENT_AND_DIFFUSE);
    float spec[4] = {0.12f, 0.12f, 0.12f, 1};
    glMaterialfv(GL_FRONT_AND_BACK, GL_SPECULAR, spec); glMaterialf(GL_FRONT_AND_BACK, GL_SHININESS, 24);
    glHint(GL_FOG_HINT, GL_NICEST);
    glHint(GL_POINT_SMOOTH_HINT, GL_NICEST);

    srand(5);
    for (int i = 0; i < 900; i++) {                      // stars on the upper hemisphere
        float x, y, z, l;
        do { x = frand(-1, 1); y = frand(0.02f, 1); z = frand(-1, 1); l = sqrtf(x * x + y * y + z * z); } while (l > 1 || l < 0.2f);
        starP[i][0] = x / l * 540; starP[i][1] = y / l * 540; starP[i][2] = z / l * 540; starPh[i] = frand(0, 6.28f);
    }
    for (int i = 0; i < 12; i++) {
        clouds[i].x = frand(-500, 500); clouds[i].y = frand(90, 150); clouds[i].z = frand(-420, 60); clouds[i].s = frand(14, 30);
    }
    buildStatic();
    initPeople();
    initBalloons();
    lastMs = glutGet(GLUT_ELAPSED_TIME);
}

int main(int argc, char** argv) {
    glutInit(&argc, argv);
    unsigned int mode = GLUT_DOUBLE | GLUT_RGB | GLUT_DEPTH;
#ifdef GLUT_MULTISAMPLE
    mode |= GLUT_MULTISAMPLE;
#endif
    glutInitDisplayMode(mode);
    glutInitWindowSize(winW, winH);
    glutCreateWindow("3D Carnival");
    initScene();
    glutDisplayFunc(display); glutReshapeFunc(reshape);
    glutKeyboardFunc(keyDown); glutKeyboardUpFunc(keyUp);
    glutSpecialFunc(specialDown); glutSpecialUpFunc(specialUp);
    glutMouseFunc(mouseBtn); glutPassiveMotionFunc(mouseMove); glutMotionFunc(mouseMove);
    glutIgnoreKeyRepeat(1);
    glutTimerFunc(16, timer, 0);
    glutMainLoop();
    return 0;
}
