static const float CAR_X = -24, CAR_Z = -48;     // carousel
static const float FER_X = 26,  FER_Z = -56;     // ferris wheel
static const float TENT_Z = -74;                 // big top

static bool solid(float x, float z, float ox, float oz) {
    float ax = fabsf(x);
    // perimeter fence
    if (ax > 33.4f && ax < 34.6f && z < 25.5f && z > -89.6f) return true;
    if (z < -88.4f && z > -89.6f && ax < 34.6f) return true;
    if (fabsf(z - 25) < 0.5f && ax > 5.6f && ax < 34.6f) return true;
    // gate doors when closed (only blocks people trying to cross, never traps someone)
    if (gateAng < 60 && ax < 5.7f && fabsf(z - 25) < 0.7f && !(fabsf(oz - 25) < 0.7f)) return true;
    // shops
    for (int i = 0; i < 12; i++)
        if (fabsf(z - shops[i].z) < 3.4f && ax > 6.9f && ax < 12.3f) return true;
    // carousel, ferris legs, big top
    if (hypotf(x - CAR_X, z - CAR_Z) < 8.5f) return true;
    for (int a = -1; a <= 1; a += 2) for (int b = -1; b <= 1; b += 2)
        if (hypotf(x - (FER_X + a * 3.5f), z - (FER_Z + b * 9.0f)) < 1.2f) return true;
    if (hypotf(x, z - TENT_Z) < 10.8f) return true;
    // lamp poles and trees
    for (size_t i = 0; i < trees.size(); i++)
        if (hypotf(x - trees[i].x, z - trees[i].z) < 0.9f) return true;
    (void)ox;
    return false;
}

// ------------------------------------------------------------ static scene
static void fenceLine(float x1, float z1, float x2, float z2) {
    float dx = x2 - x1, dz = z2 - z1, len = sqrtf(dx * dx + dz * dz);
    int n = (int)(len / 1.5f);
    col(0.93f, 0.93f, 0.96f);
    for (int i = 0; i <= n; i++) {
        float t = i / (float)n;
        box(x1 + dx * t, 0.7f, z1 + dz * t, 0.14f, 1.4f, 0.14f);
        sphere(x1 + dx * t, 1.45f, z1 + dz * t, 0.1f, 6, 6);
    }
    glPushMatrix();
    glTranslatef((x1 + x2) / 2, 0, (z1 + z2) / 2);
    glRotatef(atan2f(-dz, dx) / DEG, 0, 1, 0);
    box(0, 0.5f, 0, len, 0.1f, 0.07f);
    box(0, 1.0f, 0, len, 0.1f, 0.07f);
    glPopMatrix();
}

static void drawTree(float x, float z, float s, int kind) {
    col(0.35f, 0.22f, 0.12f);
    upCyl(x, 0, z, 0.28f * s, 0.2f * s, 2.6f * s, 8);
    if (kind == 1) {
        col(0.08f, 0.33f, 0.2f);
        for (int i = 0; i < 3; i++) {
            glPushMatrix(); glTranslatef(x, (1.8f + i * 1.3f) * s, z); glRotatef(-90, 1, 0, 0);
            glutSolidCone((2.0f - i * 0.5f) * s, 2.4f * s, 10, 2); glPopMatrix();
        }
    } else {
        float g = frand(0.8f, 1.15f);
        if (kind == 2) col(0.95f, 0.62f, 0.78f); else col(0.12f * g, 0.46f * g, 0.16f * g);
        sphere(x, 3.6f * s, z, 1.7f * s, 12, 10);
        sphere(x + 0.9f * s, 3.2f * s, z + 0.3f * s, 1.2f * s, 10, 8);
        sphere(x - 0.8f * s, 3.3f * s, z - 0.4f * s, 1.2f * s, 10, 8);
    }
}

static void buildStatic() {
    srand(1234);
    staticList = glGenLists(1);
    glNewList(staticList, GL_COMPILE);

    // --- grass (10 x 10 tiles with slight colour variation)
    glBegin(GL_QUADS);
    glNormal3f(0, 1, 0);
    for (int i = -30; i < 30; i++)
        for (int j = -30; j < 30; j++) {
            float v = frand(-0.035f, 0.035f) + (((i + j) & 1) ? 0.02f : 0);
            glColor3f(0.14f + v, 0.42f + v, 0.17f + v);
            glVertex3f(i * 10.0f, 0, j * 10.0f);       glVertex3f(i * 10.0f, 0, j * 10.0f + 10);
            glVertex3f(i * 10.0f + 10, 0, j * 10.0f + 10); glVertex3f(i * 10.0f + 10, 0, j * 10.0f);
        }
    glEnd();

    // --- stone main path (2x2 tiles) from outside the gate to the big top
    glBegin(GL_QUADS);
    glNormal3f(0, 1, 0);
    for (int i = -2; i < 2; i++)
        for (int j = -31; j < 30; j++) {
            float v = ((i + j) & 1) ? 0.05f : 0.0f;
            glColor3f(0.64f - v, 0.57f - v, 0.46f - v);
            glVertex3f(i * 2.0f, 0.03f, j * 2.0f);          glVertex3f(i * 2.0f, 0.03f, j * 2.0f + 2);
            glVertex3f(i * 2.0f + 2, 0.03f, j * 2.0f + 2);  glVertex3f(i * 2.0f + 2, 0.03f, j * 2.0f);
        }
    glEnd();
    // side paths to the rides
    glBegin(GL_QUADS);
    glNormal3f(0, 1, 0);
    col(0.60f, 0.53f, 0.43f);
    glVertex3f(-16, 0.032f, CAR_Z - 2); glVertex3f(-16, 0.032f, CAR_Z + 2); glVertex3f(-4, 0.032f, CAR_Z + 2); glVertex3f(-4, 0.032f, CAR_Z - 2);
    glVertex3f(4, 0.032f, FER_Z - 2);   glVertex3f(4, 0.032f, FER_Z + 2);   glVertex3f(18, 0.032f, FER_Z + 2); glVertex3f(18, 0.032f, FER_Z - 2);
    glEnd();
    // plazas
    col(0.66f, 0.58f, 0.46f);
    glPushMatrix(); glTranslatef(CAR_X, 0.035f, CAR_Z); glRotatef(-90, 1, 0, 0); gluDisk(Q, 0, 12.5, 48, 1); glPopMatrix();
    glPushMatrix(); glTranslatef(FER_X, 0.035f, FER_Z); glRotatef(-90, 1, 0, 0); gluDisk(Q, 0, 15, 48, 1); glPopMatrix();
    glPushMatrix(); glTranslatef(0, 0.035f, TENT_Z + 2); glRotatef(-90, 1, 0, 0); gluDisk(Q, 0, 17, 48, 1); glPopMatrix();
    // red carpet in front of the entrance
    col(0.65f, 0.08f, 0.12f);
    box(0, 0.04f, 25, 11.3f, 0.02f, 3.0f);
    // curbs
    col(0.75f, 0.75f, 0.78f);
    box(-4.15f, 0.08f, -17, 0.25f, 0.16f, 120); box(4.15f, 0.08f, -17, 0.25f, 0.16f, 120);

    // --- perimeter fence
    fenceLine(-34, 25, -6.9f, 25);  fenceLine(6.9f, 25, 34, 25);
    fenceLine(-34, 25, -34, -89);   fenceLine(34, 25, 34, -89);
    fenceLine(-34, -89, 34, -89);

    // --- flower beds along the path
    for (int s = -1; s <= 1; s += 2)
        for (int j = 0; j < 130; j++) {
            float z = 58 - j * 0.95f;
            if (fabsf(z - CAR_Z) < 2.5f && s < 0) continue;
            if (fabsf(z - FER_Z) < 2.5f && s > 0) continue;
            float x = s * (5.1f + frand(0, 1.3f));
            int c = rand() % 8;
            col(0.1f, 0.5f, 0.15f); sphere(x, 0.12f, z, 0.2f, 5, 4);
            col(PAL[c][0], PAL[c][1], PAL[c][2]); sphere(x, 0.3f, z, 0.17f, 6, 5);
        }

    // --- trees (inside the park behind the shops + outside the fence)
    int placed = 0, tries = 0;
    while (placed < 130 && tries < 4000) {
        tries++;
        float x = frand(-70, 70), z = frand(-100, 75);
        bool inside = fabsf(x) < 37 && z < 29 && z > -93;
        if (inside) {
            if (fabsf(x) < 15 || fabsf(x) > 32 || z > 20 || z < -86) continue;
            if (hypotf(x - CAR_X, z - CAR_Z) < 15 || hypotf(x - FER_X, z - FER_Z) < 19 || hypotf(x, z - TENT_Z) < 15) continue;
        } else {
            if (fabsf(x) < 9 && z > 20) continue;                  // keep the approach clear
            if (fabsf(x) < 38 && z < 30 && z > -94) continue;
        }
        trees.push_back({x, z});
        int r = rand() % 10;
        drawTree(x, z, frand(0.8f, 1.4f), r < 5 ? 0 : (r < 8 ? 1 : 2));
        placed++;
    }
    glEndList();
}

// ------------------------------------------------------------ people
struct Person {
    float x, z, dir, speed, lane, phase, dist, spawn;
    bool active;
    float sh[3], pa[3], ha[3], sk[3];
};
static std::vector<Person> people;

static void drawPerson(float x, float z, float yawDeg, float swing, const float* sh, const float* pa,
                       const float* ha, const float* sk, float sc) {
    glPushMatrix();
    glTranslatef(x, 0, z); glRotatef(yawDeg, 0, 1, 0); glScalef(sc, sc, sc);
    for (int s = -1; s <= 1; s += 2) {
        glPushMatrix(); glTranslatef(s * 0.12f, 0.85f, 0); glRotatef(s * swing * 35, 1, 0, 0);
        colv(pa);  box(0, -0.42f, 0, 0.17f, 0.85f, 0.2f);
        col(0.1f, 0.1f, 0.1f); box(0, -0.85f, 0.05f, 0.18f, 0.1f, 0.3f);
        glPopMatrix();
    }
    colv(sh); box(0, 1.15f, 0, 0.46f, 0.6f, 0.26f);
    for (int s = -1; s <= 1; s += 2) {
        glPushMatrix(); glTranslatef(s * 0.3f, 1.4f, 0); glRotatef(-s * swing * 30, 1, 0, 0);
        colv(sh); box(0, -0.25f, 0, 0.12f, 0.5f, 0.14f);
        colv(sk); box(0, -0.55f, 0, 0.1f, 0.12f, 0.12f);
        glPopMatrix();
    }
    colv(sk); sphere(0, 1.62f, 0, 0.15f, 12, 10);
    colv(ha); glPushMatrix(); glTranslatef(0, 1.69f, -0.02f); glScalef(1, 0.65f, 1); glutSolidSphere(0.16, 10, 8); glPopMatrix();
    glPopMatrix();
}

static void initPeople() {
    srand(77);
    for (int i = 0; i < 26; i++) {
        Person p;
        p.lane = frand(-3.2f, 3.2f); p.z = frand(-58, 24); p.dir = (rand() & 1) ? 1.f : -1.f;
        p.speed = frand(0.9f, 1.8f); p.phase = frand(0, 6.28f); p.dist = frand(0, 50); p.spawn = 0;
        p.active = true; p.x = p.lane;
        int c = rand() % 8, d = rand() % 8, k = rand() % 4;
        for (int q = 0; q < 3; q++) {
            p.sh[q] = PAL[c][q]; p.pa[q] = PAL[d][q] * 0.45f + 0.05f; p.sk[q] = SKIN[k][q];
        }
        float h = frand(0.05f, 0.5f); p.ha[0] = h; p.ha[1] = h * 0.7f; p.ha[2] = h * 0.4f;
        people.push_back(p);
    }
}

