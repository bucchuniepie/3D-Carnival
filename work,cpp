struct Balloon { float x, y, z, ph, sp, sz; float c[3]; };
static std::vector<Balloon> balloons;
static void initBalloons() {
    srand(99);
    for (int i = 0; i < 40; i++) {
        Balloon b;
        b.x = frand(-30, 30); b.z = frand(-84, 28); b.y = frand(8, 22);
        b.ph = frand(0, 6.28f); b.sp = frand(0.7f, 1.4f); b.sz = frand(0.55f, 0.9f);
        int c = rand() % 8; for (int q = 0; q < 3; q++) b.c[q] = PAL[c][q];
        balloons.push_back(b);
    }
}
static void drawBalloons() {
    for (size_t i = 0; i < balloons.size(); i++) {
        const Balloon& b = balloons[i];
        float bx = b.x + 2.2f * sinf(balloonT * 0.25f * b.sp + b.ph);
        float by = b.y + 1.6f * sinf(balloonT * 0.45f * b.sp + b.ph * 1.7f);
        float bz = b.z + 2.2f * cosf(balloonT * 0.20f * b.sp + b.ph);
        glPushMatrix(); glTranslatef(bx, by, bz);
        colv(b.c);
        glPushMatrix(); glScalef(1, 1.22f, 1); glutSolidSphere(b.sz, 16, 12); glPopMatrix();
        glPushMatrix(); glTranslatef(0, -b.sz * 1.22f - 0.12f, 0); glRotatef(-90, 1, 0, 0);
        glutSolidCone(0.11f, 0.2f, 8, 1); glPopMatrix();
        glDisable(GL_LIGHTING); glColor3f(0.85f, 0.85f, 0.85f);
        glBegin(GL_LINE_STRIP);
        for (int k = 0; k <= 6; k++) {
            float t = k / 6.0f;
            glVertex3f(0.5f * t * sinf(balloonT + b.ph + t * 3), -b.sz * 1.22f - 0.2f - t * 5.0f, 0.5f * t * cosf(balloonT * 0.8f + b.ph));
        }
        glEnd();
        glEnable(GL_LIGHTING);
        glPopMatrix();
    }
}

// ------------------------------------------------------------ shops
static void drawShop(int idx) {
    const Shop& s = shops[idx];
    const float* c = PAL[s.c];
    glPushMatrix();
    glTranslatef(s.x, 0, s.z); glRotatef(s.rot, 0, 1, 0);
    // floor, walls, roof
    col(0.78f, 0.74f, 0.68f); box(0, 0.1f, 0.2f, 6.4f, 0.2f, 5.2f);
    colv(c);                  box(0, 1.8f, -1.9f, 6, 3.2f, 0.2f);
    col(c[0] * 0.8f, c[1] * 0.8f, c[2] * 0.8f);
    box(-2.9f, 1.8f, 0, 0.2f, 3.2f, 4); box(2.9f, 1.8f, 0, 0.2f, 3.2f, 4);
    col(0.25f, 0.2f, 0.25f);  box(0, 3.55f, 0, 6.6f, 0.25f, 4.8f);
    // counter
    col(0.55f, 0.36f, 0.2f);  box(0, 0.6f, 1.5f, 5.4f, 1.0f, 0.8f);
    col(0.85f, 0.7f, 0.5f);   box(0, 1.15f, 1.5f, 5.6f, 0.1f, 1.0f);
    // goods on counter
    for (int i = 0; i < 7; i++) {
        int k = (idx + i) % 8;
        col(PAL[k][0], PAL[k][1], PAL[k][2]);
        if (i & 1) sphere(-2.3f + i * 0.75f, 1.38f, 1.5f, 0.2f, 8, 6);
        else       box(-2.3f + i * 0.75f, 1.33f, 1.5f, 0.35f, 0.3f, 0.35f);
    }
