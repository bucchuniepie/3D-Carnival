// --------------------------------------------------------------- utilities
static float clamp01(float v) { return v < 0 ? 0 : (v > 1 ? 1 : v); }
static float mixf(float a, float b, float t) { return a + (b - a) * t; }
static float frand(float a, float b) { return a + (b - a) * (rand() / (float)RAND_MAX); }
static float smooth(float t) { t = clamp01(t); return t * t * (3 - 2 * t); }

static void col(float r, float g, float b) { glColor3f(r, g, b); }
static void colv(const float* c) { glColor3f(c[0], c[1], c[2]); }

static void box(float cx, float cy, float cz, float sx, float sy, float sz) {
    glPushMatrix(); glTranslatef(cx, cy, cz); glScalef(sx, sy, sz); glutSolidCube(1.0); glPopMatrix();
}
static void sphere(float x, float y, float z, float r, int sl = 16, int st = 12) {
    glPushMatrix(); glTranslatef(x, y, z); glutSolidSphere(r, sl, st); glPopMatrix();
}
// vertical cylinder (base at y), with a top cap
static void upCyl(float x, float y, float z, float r1, float r2, float h, int sl = 16, bool cap = true) {
    glPushMatrix(); glTranslatef(x, y, z); glRotatef(-90, 1, 0, 0);
    gluCylinder(Q, r1, r2, h, sl, 1);
    if (cap) { glTranslatef(0, 0, h); gluDisk(Q, 0, r2, sl, 1); }
    glPopMatrix();
}
// cylinder between two points
static void beam(float x1, float y1, float z1, float x2, float y2, float z2, float r) {
    float dx = x2 - x1, dy = y2 - y1, dz = z2 - z1;
    float len = sqrtf(dx * dx + dy * dy + dz * dz);
    if (len < 1e-4f) return;
    glPushMatrix(); glTranslatef(x1, y1, z1);
    float ax = -dy, ay = dx;
    if (fabsf(ax) + fabsf(ay) > 1e-5f) glRotatef(acosf(dz / len) / DEG, ax, ay, 0);
    else if (dz < 0) glRotatef(180, 1, 0, 0);
    gluCylinder(Q, r, r, len, 8, 1);
    glPopMatrix();
}

// ------------------------------------------------- glowing bulbs (halo pass)
struct Glow { float x, y, z, r, g, b, s; };
static std::vector<Glow> glows;

static void addGlow(float x, float y, float z, float r, float g, float b, float s) {
    float m[16]; glGetFloatv(GL_MODELVIEW_MATRIX, m);
    Glow gl;
    gl.x = m[0] * x + m[4] * y + m[8]  * z + m[12];
    gl.y = m[1] * x + m[5] * y + m[9]  * z + m[13];
    gl.z = m[2] * x + m[6] * y + m[10] * z + m[14];
    gl.r = r; gl.g = g; gl.b = b; gl.s = s;
    glows.push_back(gl);
}
static void bulb(float x, float y, float z, float r, float g, float b, float s = 0.12f) {
    float k = 0.10f + 0.90f * lamp;
    glDisable(GL_LIGHTING);
    glColor3f(r * k, g * k, b * k);
    sphere(x, y, z, s, 6, 6);
    glEnable(GL_LIGHTING);
    if (glowLevel > 0.05f) addGlow(x, y, z, r, g, b, s);
}
static void drawGlows() {
    glDisable(GL_LIGHTING); glDisable(GL_FOG);
    glEnable(GL_BLEND); glBlendFunc(GL_SRC_ALPHA, GL_ONE);
    glDepthMask(GL_FALSE); glEnable(GL_POINT_SMOOTH);
    glMatrixMode(GL_MODELVIEW); glPushMatrix(); glLoadIdentity();
    float K = winH * 0.5f / tanf(32.5f * DEG);
    for (size_t i = 0; i < glows.size(); i++) {
        const Glow& g = glows[i];
        float depth = -g.z;
        if (depth < 0.3f) continue;
        float px = 2.0f * g.s * 4.5f * K / depth;
        if (px > 70) px = 70;
        if (px < 2) px = 2;
        float a = glowLevel;
        glPointSize(px);        glColor4f(g.r, g.g, g.b, 0.09f * a); glBegin(GL_POINTS); glVertex3f(g.x, g.y, g.z); glEnd();
        glPointSize(px * 0.5f); glColor4f(g.r, g.g, g.b, 0.20f * a); glBegin(GL_POINTS); glVertex3f(g.x, g.y, g.z); glEnd();
        glPointSize(px * 0.2f); glColor4f(1, 1, 1, 0.35f * a);       glBegin(GL_POINTS); glVertex3f(g.x, g.y, g.z); glEnd();
    }
    glPopMatrix();
    glDisable(GL_POINT_SMOOTH); glDepthMask(GL_TRUE); glDisable(GL_BLEND);
}

// ------------------------------------------------------------ stroke text
static void signText(const char* s, float w, float h, float r, float g, float b) {
    float len = (float)glutStrokeLength(GLUT_STROKE_ROMAN, (const unsigned char*)s);
    float sc = std::min(w / len, h / 119.0f);
    float k = 0.35f + 0.65f * lamp;
    glDisable(GL_LIGHTING);
    glColor3f(r * k, g * k, b * k);
    glLineWidth(2.5f);
    glPushMatrix();
    glTranslatef(-len * sc * 0.5f, -59.0f * sc, 0);
    glScalef(sc, sc, sc);
    for (const char* p = s; *p; p++) glutStrokeCharacter(GLUT_STROKE_ROMAN, *p);
    glPopMatrix();
    glLineWidth(1);
    glEnable(GL_LIGHTING);
}

